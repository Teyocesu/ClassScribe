# Optional Apple code signing and notarization for a future local distribution path.
# The GitHub tag-release workflow intentionally uses ad-hoc signing and needs none
# of these values. See: scripts/build_release.sh, scripts/notarize_status.sh.
DEVELOPER_ID="Developer ID Application: Your Name (XXXXXXXXXX)"
NOTARY_KEYCHAIN_PROFILE=classscribe-notary

# Legacy alternative accepted by scripts/notarize_status.sh only. Prefer a
# notarytool keychain profile so an app-specific password is not kept in .env.
# APPLE_ID=your@email.com
# TEAM_ID=XXXXXXXXXX
# APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
